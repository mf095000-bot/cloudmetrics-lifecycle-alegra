# Nombres de variables de entorno requeridas por la Fase 8A (docs/08A_INTEGRATION_SETUP.md §6).
# No poner valores reales aquí. Las credenciales reales se configuran como
# Environment variables/Secrets del Environment de Claude Code on the web,
# nunca en este archivo ni en el chat.

# HubSpot — Customer/Lifecycle Layer (docs/08A_INTEGRATION_SETUP.md §2.6)
HUBSPOT_PRIVATE_APP_TOKEN=
HUBSPOT_PORTAL_ID=

# Supabase — Product Behavioral Layer (docs/08A_INTEGRATION_SETUP.md §3.6)
SUPABASE_URL=
SUPABASE_SERVICE_ROLE_KEY=

# Resend — envío de email (docs/08A_INTEGRATION_SETUP.md §4.3)
RESEND_API_KEY=
RESEND_FROM_ADDRESS=

# Slack — notificación operativa interna (docs/08A_INTEGRATION_SETUP.md §5.3)
SLACK_BOT_TOKEN=
SLACK_CHANNEL_ID=
